#!/bin/bash

function exit_script() {
	if ! [ -z "$CYDIA" ]; then
		read -r fd ver <<EOT
$CYDIA
EOT
        if [ "$ver" -ge 1 ]; then
            echo "finish:$1" >&$fd
        fi
    fi
    exit 0
}

chmod -R 0777 /amethyst/update | true
rm -rf /amethyst/launchd_hook.dylib | true
mv /amethyst/update/launchd_hook.dylib /amethyst/launchd_hook.dylib | true
chmod 0755 /amethyst/launchd_hook.dylib | true
chown 0:0 /amethyst/launchd_hook.dylib | true

rm -rf /amethyst/dyld_patch_text_12.bin | true
rm -rf /amethyst/dyld_patch_text_13.bin | true
mv /amethyst/update/dyld_patch_text_12.bin /amethyst/dyld_patch_text_12.bin | true
mv /amethyst/update/dyld_patch_text_13.bin /amethyst/dyld_patch_text_13.bin | true

rm -rf /amethyst/jbutil | true
mv /amethyst/update/jbutil /amethyst/jbutil | true
chmod 0755 /amethyst/jbutil | true
chown 0:0 /amethyst/jbutil | true

DYLD_INSERT_LIBRARIES=/amethyst/launchd_hook.dylib /amethyst/jbutil -h 2> /dev/null | true
sync
reboot
exit_script return
